# Variáveis do Painel de Lucro (Vercel → Settings → Environment Variables). Nunca commitar valores reais.

# Banco do cliente (Supabase → Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel (o cliente entra com ela)
PAINEL_SENHA=

# Senha que vai no link do webhook do gateway (?token=). Gere uma longa e aleatória.
WEBHOOK_TOKEN=
# Opcionais por gateway: hottok da Hotmart / token da Kiwify (assinatura)
HOTMART_HOTTOK=
KIWIFY_TOKEN=

# Senha do robô de hora em hora (/api/cron?key=). Gere uma longa e aleatória.
CRON_SECRET=

# Meta Ads: token do usuário do sistema da BM com ads_read na conta, e o número da conta (sem act_)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Só se as campanhas otimizam por evento PERSONALIZADO do pixel (nome exato do evento)
META_EVENTO_COMPRA=
META_EVENTO_CHECKOUT=

# Planilha de gastos — opção 1 (recomendada): conta de serviço do Google (JSON inteiro da chave) + id da planilha
GOOGLE_SERVICE_ACCOUNT_JSON=
PLANILHA_ID=
# Planilha de gastos — opção 2: abas publicadas como CSV (Arquivo → Compartilhar → Publicar na web)
PLANILHA_CSV_GASTOS=
PLANILHA_CSV_CONFIG=

# Demonstração com dados fictícios (senha "demo"). Deixe vazio em cliente real.
DEMO=
